# Fortivex LMS — Environment Variable Template
# Placeholders only. Never commit real values. Copy to .env / .env.local
# and fill in locally or via Railway/Vercel environment settings.
#
# This file describes the target architecture's configuration surface
# (see docs/ARCHITECTURE.md). No application code exists yet to consume
# these — this is the contract implementation should follow once it starts.

# --- General ---
ENVIRONMENT=development            # development | staging | production
APP_NAME=Fortivex LMS

# --- Backend (FastAPI) ---
DATABASE_URL=postgresql://user:password@localhost:5432/fortivex_lms
REDIS_URL=redis://localhost:6379/0

JWT_SECRET_KEY=replace-with-a-strong-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- AI & Chatbot Configuration ---
AI_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
CHATBOT_DAILY_ALLOWANCE_SECONDS=300
CHATBOT_TIMEZONE=Asia/Kolkata
CHATBOT_HEARTBEAT_INTERVAL_SECONDS=10
CHATBOT_IDLE_TIMEOUT_SECONDS=30

# --- Object storage (S3-compatible) ---
STORAGE_ENDPOINT_URL=
STORAGE_BUCKET_NAME=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_REGION=

# --- Email (branding-aware sending) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@example.com

# --- Frontend (Next.js) ---
# Relative by default: browser makes same-origin requests to Next.js (/api/v1/...)
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_JITSI_DOMAIN=meet.systemli.org
# Internal backend destination for Next.js server-side rewrites (in Docker: http://backend:8000)
INTERNAL_API_URL=http://backend:8000


# --- Multi-org / domain resolution ---
# No org-specific values belong here — organization + domain mapping is
# database-driven (organizations, organization_domains tables), not
# environment-variable-driven. Do not add EMPOWERS_* / MEDIVEX_* variables.
